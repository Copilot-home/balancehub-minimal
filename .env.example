# Optional. Keep empty for public-safe minimal mode.
STRIPE_API_KEY=
# Optional override. Default is sqlite:///./balancehub.db for one-container run.
DATABASE_URL=postgresql://hub:hubpass@postgres:5432/balancehub
REDIS_URL=redis://redis:6379

# Optional growth/economic signals for /system/economic-weight
GITHUB_REPO=NguyenCuong1989/balancehub-minimal
GITHUB_TOKEN=
DOCKER_PULLS=0
HF_LIKES=0
STRIPE_REVENUE_USD=0

# Optional email control plane (disabled by default)
CONTROL_EMAIL_ENABLED=false
CONTROL_EMAIL_ADMIN_TOKEN=
CONTROL_EMAIL_ALLOWED_SENDERS=nguyencuong.2509@icloud.com,nguyencuong.2509@gmail.com
CONTROL_EMAIL_EXECUTE_URL=http://127.0.0.1:8000/execute

# IMAP source inbox (for command ingestion)
CONTROL_EMAIL_IMAP_HOST=
CONTROL_EMAIL_IMAP_PORT=993
CONTROL_EMAIL_IMAP_USERNAME=
CONTROL_EMAIL_IMAP_PASSWORD=
CONTROL_EMAIL_IMAP_FOLDER=INBOX

# SMTP reply channel (optional)
CONTROL_EMAIL_SMTP_HOST=
CONTROL_EMAIL_SMTP_PORT=465
CONTROL_EMAIL_SMTP_USERNAME=
CONTROL_EMAIL_SMTP_PASSWORD=
CONTROL_EMAIL_SMTP_SSL=true
CONTROL_EMAIL_FROM=

# Canonical integrity protection
# No bypass is supported. Startup is blocked when canon hash mismatches.
# Optional shared secret to produce X-APO-Proof / /canon/proof signature
APO_CANON_SIGNING_KEY=
